{
  "name": "the_platform",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "frontend": "cd frontend && pnpm run dev",
    "backend": "cd backend && pnpm run dev",
    "start": "concurrently \"pnpm run frontend\" \"pnpm run backend\"",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.15.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "frontend/**/*.{js,ts,tsx}": "eslint --config frontend/eslint.config.mjs --fix",
    "backend/**/*.{js,ts,tsx}": "eslint --config backend/eslint.config.mjs --fix"
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}
